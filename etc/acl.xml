<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="UpturnStudio_GoogleFeed::root" title="Google Feeds" translate="title" sortOrder="210">
                    <resource id="UpturnStudio_GoogleFeed::feeds" title="Manage Feeds" translate="title" sortOrder="10"/>
                    <resource id="UpturnStudio_GoogleFeed::api" title="API" translate="title" sortOrder="20">
                        <resource id="UpturnStudio_GoogleFeed::api_feeds" title="Read Feed List" translate="title" sortOrder="10"/>
                        <resource id="UpturnStudio_GoogleFeed::api_attributes" title="Read and Write Google Attribute Values" translate="title" sortOrder="20"/>
                        <resource id="UpturnStudio_GoogleFeed::api_orders" title="Read Click-Attributed Orders" translate="title" sortOrder="30"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="UpturnStudio_GoogleFeed::config" title="Google Feeds Section" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
